#!/usr/bin/env python
import os
import sys

I18N_PACKAGE = 'wasapi-backend'

def options(opt):
    pass

def configure(conf):
    # WASAPI is Windows-only; configure still succeeds so the module can be
    # listed in BACKENDS on win64 builds. COM headers come from the Windows SDK.
    pass

def build(bld):
    obj = bld(features='cxx cxxshlib')
    obj.source = [
        'wasapi_backend.cc',
        'wasapi_io.cc',
    ]
    obj.includes = ['.']
    obj.name = 'wasapi_audiobackend'
    obj.target = 'wasapi_audiobackend'
    obj.use = 'libardour libpbd'
    obj.uselib = 'GLIBMM XML'
    if bld.env['build_target'] in ('mingw', 'msvc') or sys.platform == 'win32':
        obj.lib = ['ole32', 'winmm', 'uuid', 'avrt']
    obj.install_path = os.path.join(bld.env['LIBDIR'], 'backends')
    obj.defines = [
        'PACKAGE="' + I18N_PACKAGE + '"',
        'ARDOURBACKEND_DLL_EXPORTS',
        'BACKEND_NAME="WASAPI"',
        'USE_MMCSS_THREAD_PRIORITIES',
    ]
