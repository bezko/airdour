@prefix doap: <http://usefulinc.com/ns/doap#> .
@prefix foaf: <http://xmlns.com/foaf/0.1/> .
@prefix lv2:  <http://lv2plug.in/ns/lv2core#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix unit: <http://lv2plug.in/ns/extensions/units#> .

<http://ardour.org/credits.html>
	a foaf:Person ;
	foaf:name "Airdour contributors" ;
	foaf:homepage <http://ardour.org/> .

<urn:ardour:a-limiter>
    a lv2:Plugin, doap:Project, lv2:LimiterPlugin ;
    lv2:optionalFeature lv2:hardRTCapable ;
    doap:name "ACE Limiter" ;
    doap:license <http://opensource.org/licenses/gpl-2.0.php> ;
    doap:maintainer <http://ardour.org/credits.html> ;
    rdfs:comment "Peak limiter with Ceiling and Release." ;

    lv2:port [
        a lv2:InputPort, lv2:ControlPort ;
        lv2:index 0 ;
        lv2:name "Ceiling" ;
        lv2:symbol "ceiling" ;
        lv2:default -0.300000 ;
        lv2:minimum -20.000000 ;
        lv2:maximum 0.000000 ;
        unit:unit unit:db ;
    ] ,
    [
        a lv2:InputPort, lv2:ControlPort ;
        lv2:index 1 ;
        lv2:name "Release" ;
        lv2:symbol "release" ;
        lv2:default 100.000000 ;
        lv2:minimum 1.000000 ;
        lv2:maximum 2000.000000 ;
        unit:unit unit:ms ;
    ] ,
    [
        a lv2:InputPort, lv2:ControlPort ;
        lv2:index 2 ;
        lv2:name "Enable" ;
        lv2:symbol "enable" ;
        lv2:default 1 ;
        lv2:minimum 0 ;
        lv2:maximum 1 ;
        lv2:portProperty lv2:toggled, lv2:integer ;
    ] ,
    [
        a lv2:InputPort, lv2:AudioPort ;
        lv2:index 3 ;
        lv2:symbol "in_1" ;
        lv2:name "Audio Input 1" ;
    ] ,
    [
        a lv2:OutputPort, lv2:AudioPort ;
        lv2:index 4 ;
        lv2:symbol "out_1" ;
        lv2:name "Audio Output 1" ;
    ] .
