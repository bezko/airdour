{
  "version": 3,
  "cmakeMinimumRequired": { "major": 3, "minor": 20, "patch": 0 },
  "configurePresets": [
    {
      "name": "base",
      "hidden": true,
      "generator": "Ninja",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "AIRDOUR_BUILD_WASAPI_IO_SMOKE": "ON",
        "AIRDOUR_BUILD_WIN_SHELL": "ON",
        "BUILD_TESTING": "ON"
      }
    },
    {
      "name": "ui",
      "inherits": "base",
      "displayName": "UI-only shell",
      "description": "Direct2D shell without libardour (CI green path).",
      "binaryDir": "${sourceDir}/../../build-ninja-ui",
      "cacheVariables": {
        "AIRDOUR_WIN_SHELL_WITH_ENGINE": "OFF"
      }
    },
    {
      "name": "engine",
      "inherits": "base",
      "displayName": "Engine-linked shell",
      "description": "Links the waf Release engine; run tools/win-native/build-waf-release.cmd first.",
      "binaryDir": "${sourceDir}/../../build-ninja-engine",
      "cacheVariables": {
        "AIRDOUR_WIN_SHELL_WITH_ENGINE": "ON",
        "AIRDOUR_WAF_BUILD_DIR": "${sourceDir}/../../build-rel"
      }
    },
    {
      "name": "vst2-bridge-x86",
      "inherits": "base",
      "displayName": "VST2-32 helper",
      "description": "i386 ardour-vst2-bridge-x86.exe in its own tree. Configure from an x86 MSVC prompt (vcvarsall.bat x86). Ninja does not accept -A; an x64 cl.exe fails the architecture check. Does not build the win64 shell.",
      "binaryDir": "${sourceDir}/../../build-win32-vst2-bridge",
      "cacheVariables": {
        "AIRDOUR_BUILD_VST2_BRIDGE_X86": "ON",
        "AIRDOUR_BUILD_WIN_SHELL": "OFF",
        "AIRDOUR_BUILD_WASAPI_IO_SMOKE": "OFF",
        "BUILD_TESTING": "OFF"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "ui",
      "configurePreset": "ui",
      "targets": ["wasapi_io_smoke", "airdour_win_shell"]
    },
    {
      "name": "engine",
      "configurePreset": "engine",
      "targets": ["airdour_win_shell"]
    },
    {
      "name": "vst2-bridge-x86",
      "configurePreset": "vst2-bridge-x86",
      "targets": ["ardour-vst2-bridge-x86"]
    }
  ],
  "testPresets": [
    {
      "name": "ui",
      "configurePreset": "ui",
      "output": { "outputOnFailure": true }
    },
    {
      "name": "engine",
      "configurePreset": "engine",
      "output": { "outputOnFailure": true }
    }
  ]
}
