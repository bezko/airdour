+bool
+MixerStrip::drag_send_pan_to (float x)
+{
+	if (_midi_strip || !_send_pan_ok) {
+		return false;
+	}
+	float w = _send_track.right - _send_track.left;
+	if (w < 1.f) {
+		return false;
+	}
+	float t = (x - _send_track.left) / w;
+	float v = std::max (0.f, std::min (1.f, t));
+	if (v == _send_pan) {
+		return false;
+	}
+	_send_pan = v;
+	return true;
+}
