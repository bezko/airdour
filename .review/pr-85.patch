 win_ardour/engine_host.h   |  12 +++
 win_ardour/main.cc         |   5 +-
 win_ardour/mixer_strip.cc  |  18 +++++
 win_ardour/mixer_strip.h   |   4 +
 win_ardour/shell_window.cc |  51 ++++++++++--
 win_ardour/shell_window.h  |   1 +
 7 files changed, 234 insertions(+), 13 deletions(-)

diff --git a/win_ardour/engine_host.cc b/win_ardour/engine_host.cc
