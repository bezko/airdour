From eddc3f26be4f0eff640bdf52ffc09b408f43b92a Mon Sep 17 00:00:00 2001
From: bezko <bezkom@gmail.com>
Date: Tue, 20 Oct 2026 04:28:46 -0400
Subject: [PATCH] Expose Aux bus return gain beside the monitor strip.

Drag the Aux fader on the Monitor column (double-click resets to unity).
--smoke-aux-return: ensure Aux, set 0.5 then 1.0, assert snapshot.
---
 win_ardour/engine_host.cc   | 96 +++++++++++++++++++++++++++++++++++++
 win_ardour/engine_host.h    |  7 +++
 win_ardour/main.cc          |  6 ++-
 win_ardour/monitor_strip.cc | 75 +++++++++++++++++++++++++++++
 win_ardour/monitor_strip.h  | 14 +++++-
 win_ardour/shell_window.cc  | 53 ++++++++++++++++++++
 win_ardour/shell_window.h   |  3 ++
 7 files changed, 251 insertions(+), 3 deletions(-)

diff --git a/win_ardour/engine_host.cc b/win_ardour/engine_host.cc
index 199e78c5406..c49852d0b35 100644
--- a/win_ardour/engine_host.cc
+++ b/win_ardour/engine_host.cc
@@ -632,6 +632,7 @@ EngineHost::EngineHost ()
 		_snap.recent_path[i][0] = L'\0';
 	}
 	_snap.aux_bus_ok = false;
+	_snap.aux_return = 1.f;
