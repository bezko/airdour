From 754099cd351a12f90e4ff9d7e496de9c8a846f59 Mon Sep 17 00:00:00 2001
From: bezko <bezkom@gmail.com>
Date: Tue, 20 Oct 2026 03:51:59 -0400
Subject: [PATCH 2/2] Use Ctrl+click for send mute (avoid Alt+click clash).

Alt+click send is reserved by open send-reset-all tip #38.
---
 win_ardour/engine_host.h   | 2 +-
 win_ardour/shell_window.cc | 7 ++++---
 2 files changed, 5 insertions(+), 4 deletions(-)

diff --git a/win_ardour/engine_host.h b/win_ardour/engine_host.h
index 3eb74712f77..d32b8c60db9 100644
--- a/win_ardour/engine_host.h
+++ b/win_ardour/engine_host.h
@@ -371,7 +371,7 @@ class EngineHost
 	/** Aux send level 0..1 (gain coeff) via InternalSend → Aux bus. */
 	bool  set_track_send (int track, float send_0_1);
 	float track_send (int track) const;
-	/** Mute aux send via Processor deactivate (Alt+click send). */
+	/** Mute aux send via Processor deactivate (Ctrl+click send). */
 	bool set_track_send_muted (int track, bool muted);
 	bool toggle_track_send_muted (int track);
 
diff --git a/win_ardour/shell_window.cc b/win_ardour/shell_window.cc
index 844ad80cd58..8236a34ae6b 100644
--- a/win_ardour/shell_window.cc
+++ b/win_ardour/shell_window.cc
@@ -4801,8 +4801,9 @@ ShellWindow::on_mouse_down (LPARAM lparam)
 
 	int send_i = hit_mixer_send (x, y);
 	if (send_i >= 0) {
-		/* Alt+click send → mute/unmute (Processor deactivate). */
-		if ((GetKeyState (VK_MENU) & 0x8000) != 0
+		/* Ctrl+click send → mute/unmute (Processor deactivate).
+		 * Alt+click remains send-reset-all on tip #38. */
+		if ((GetKeyState (VK_CONTROL) & 0x8000) != 0
 		    && _engine.is_linked () && _engine_snap.session_ok) {
 			_engine.toggle_track_send_muted (send_i);
 			_engine.poll ();
@@ -6344,7 +6345,7 @@ ShellWindow::draw_help_overlay ()
 		{ L"Y / Shift+Y", L"Spectrum on/off · Master mix" },
 		{ L"X / Shift+X", L"Phase corr / gonio · Master L/R" },
 		{ L"J / Shift+J", L"LUFS ≈ on/off · Master mix" },
-		{ L"Alt+click Send", L"Mute / unmute Aux send (Sm)" },
+		{ L"Ctrl+click Send", L"Mute / unmute Aux send (Sm)" },
 	};
 
 	float y = card.top + 40.f * _dpi_scale;
