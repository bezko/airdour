{
  "$schema": "https://raw.githubusercontent.com/microsoft/vcpkg-tool/main/docs/vcpkg.schema.json",
  "name": "airdour-win64-deps",
  "version-string": "0.4.0",
  "description": "MSVC headless/core deps for Airdour. Includes overlay glibmm-2.4 + sigc++-2.0 (not stock vcpkg glibmm 2.68+/sigc++3). GTK2 GUI intentionally omitted.",
  "dependencies": [
    "glib",
    "libsigcpp2",
    "glibmm24",
    "libxml2",
    "libsndfile",
    "curl",
    "libarchive",
    "liblo",
    "taglib",
    "vamp-sdk",
    "rubberband",
    {
      "name": "fftw3",
      "features": ["threads"]
    },
    {
      "name": "aubio",
      "default-features": false
    },
    "pthreads",
    "boost-uuid",
    "boost-tokenizer",
    "boost-bind",
    "boost-smart-ptr",
    "boost-multiprecision",
    "boost-type-traits",
    {
      "name": "getopt-win32",
      "platform": "windows"
    },
    {
      "name": "pkgconf",
      "host": true
    }
  ],
  "features": {
    "cxx-glib-modern-incompatible": {
      "description": "Stock vcpkg glibmm (2.68+/2.90) + libsigcpp 3.x — incompatible with Ardour. Prefer overlay ports libsigcpp2 + glibmm24 instead.",
      "dependencies": [
        "glibmm",
        "libsigcpp"
      ]
    }
  },
  "default-features": [],
  "supports": "windows & x64 & !uwp"
}
